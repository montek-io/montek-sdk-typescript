{
  "name": "@montek/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Montek API (api.montek.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montek-io/montek-sdk-typescript.git"
  },
  "homepage": "https://developers.montek.io",
  "keywords": [
    "montek",
    "ocr",
    "document-extraction",
    "cad",
    "dxf",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "gen": "node scripts/gen.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
